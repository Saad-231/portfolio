# ─────────────────────────────────────────────────────────────
# EmailJS credentials — used by src/components/sections/Contact.tsx
# to deliver contact-form submissions straight to your inbox
# without a custom backend.
#
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (e.g. Gmail) → copy the "Service ID"
# 3. Create an Email Template → copy the "Template ID"
#    Template should expect these variables: {{from_name}},
#    {{from_email}}, {{message}}
# 4. Account → General → copy your "Public Key"
# 5. Copy this file to ".env.local" and fill in the three values
#    below. Restart `npm run dev` after editing.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
